# 本番ビルド (dist/) を /~sugawara/jammemo/ で透過的に配信する
RewriteEngine On
RewriteBase /~sugawara/jammemo/

# .cgi を CGI スクリプトとして実行
AddHandler cgi-script .cgi

# 環境ごとの設定ファイルは配信しない。DocumentRoot の中にあるため、指定しないと
# ブラウザから中身がそのまま読めてしまう（下の RewriteCond -f で実在ファイルは
# そのまま配信されるので、Rewrite では止まらない）。
# env.pl.example や作業中のバックアップ (env.pl.bak.*) も巻き込むよう前方一致にする。
<FilesMatch "^env\.pl">
    Require all denied
</FilesMatch>

# すでに dist/ 配下へのリクエストはそのまま（無限ループ防止）
RewriteRule ^dist/ - [L]

# ルート ("/~sugawara/jammemo/") は dist/index.html を返す
RewriteRule ^$ dist/index.html [L]

# 実在するファイル/ディレクトリ（api.cgi, memo_data/ など）はそのまま配信/実行
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# それ以外のパスはすべて dist/ 配下へ転送
RewriteRule ^(.+)$ dist/$1 [L]
